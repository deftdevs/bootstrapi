{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": ["$default", "/^release\\/.*/"],
  "minimumReleaseAge": "7 days",
  "platformAutomerge": true,
  "prConcurrentLimit": 0,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates after CI passes",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Allow only Atlassian packages with SemVer version and exclude 1000er versions",
      "allowedVersions": "/^[0-9]{1,3}\\.[0-9]+\\.[0-9]+$/",
      "matchPackageNames": [
        "com.atlassian{/,}**"
      ]
    },
    {
      "description": "Keep Confluence on the 10.2 LTS line (patch updates only)",
      "matchPackageNames": [
        "com.atlassian.confluence{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^10\\.2\\.[0-9]+$/"
    },
    {
      "description": "Keep Jira on the 11.3 LTS line (patch updates only)",
      "matchPackageNames": [
        "com.atlassian.jira{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^11\\.3\\.[0-9]+$/"
    },
    {
      "description": "Crowd has no LTS line yet; keep it on 7.2, which ships platform 8.3 like the other products",
      "matchPackageNames": [
        "com.atlassian.crowd{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^7\\.2\\.[0-9]+$/"
    },
    {
      "description": "The platform BOM must match the platform version shipped by the products (see the product parent POMs)",
      "matchPackageNames": [
        "com.atlassian.platform.dependencies{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^8\\.3\\.[0-9]+$/"
    },
    {
      "description": "Jackson must match the version shipped by the products (the YAML dataformat is bundled against it)",
      "matchPackageNames": [
        "com.fasterxml.jackson{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^2\\.21\\.[0-9]+$/"
    },
    {
      "description": "The test stack mirrors the platform: Jersey 3.1, Bean Validation 3.0 (Hibernate Validator 8) and EL 5.0 (Glassfish EL 4)",
      "matchPackageNames": [
        "org.glassfish.jersey.core:jersey-common"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^3\\.1\\.[0-9]+$/"
    },
    {
      "matchPackageNames": [
        "org.hibernate.validator{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^8\\..*/"
    },
    {
      "matchPackageNames": [
        "org.glassfish:jakarta.el"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^4\\.[0-9.]+$/"
    },
    {
      "description": "SLF4J must stay on the line shipped by the products via the platform",
      "matchPackageNames": [
        "org.slf4j{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^2\\.0\\.[0-9]+$/"
    },
    {
      "description": "Log4j must stay on the line shipped by the products via the platform",
      "matchPackageNames": [
        "org.apache.logging.log4j{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^2\\.[0-9.]+$/"
    },
    {
      "description": "Spring must stay on the line shipped by the products via the platform",
      "matchPackageNames": [
        "org.springframework{/,}**"
      ],
      "matchBaseBranches": ["main"],
      "allowedVersions": "/^6\\.2\\.[0-9]+$/"
    },
    {
      "description": "Release 1.x keeps Confluence on the 9.5 line (patch updates only)",
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "com.atlassian.confluence{/,}**"
      ],
      "allowedVersions": "/^9\\.5\\.[0-9]+$/"
    },
    {
      "description": "Release 1.x keeps Jira on the 10.7 line (patch updates only)",
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "com.atlassian.jira{/,}**"
      ],
      "allowedVersions": "/^10\\.7\\.[0-9]+$/"
    },
    {
      "description": "Release 1.x keeps Crowd on the 6.3 line (patch updates only)",
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "com.atlassian.crowd{/,}**"
      ],
      "allowedVersions": "/^6\\.3\\.[0-9]+$/"
    },
    {
      "description": "Release 1.x products ship platform 7.3",
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "com.atlassian.platform.dependencies{/,}**"
      ],
      "allowedVersions": "/^7\\.3\\.[0-9]+$/"
    },
    {
      "description": "Release 1.x products ship Jackson 2.21",
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "com.fasterxml.jackson{/,}**"
      ],
      "allowedVersions": "/^2\\.21\\.[0-9]+$/"
    },
    {
      "description": "Release 1.x test stack mirrors platform 7.3: Jersey 2, Bean Validation 2.0 (Hibernate Validator 6) and EL 3.0 (Glassfish EL 3)",
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "org.glassfish.jersey.core:jersey-common"
      ],
      "allowedVersions": "/^2\\.[0-9.]+$/"
    },
    {
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "org.hibernate.validator{/,}**"
      ],
      "allowedVersions": "/^6\\..*/"
    },
    {
      "matchBaseBranches": ["release/1.x"],
      "matchPackageNames": [
        "org.glassfish:jakarta.el"
      ],
      "allowedVersions": "/^3\\.[0-9.]+$/"
    }
  ]
}
